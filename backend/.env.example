# Copy to .env and fill in real values

# --- Chatbot provider: "claude", "gemini", or "ollama" ---
LLM_PROVIDER=gemini

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini API -- free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local LLM, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Database
DATABASE_URL=sqlite:///./kiosk.db

# CORS: comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Camera wake settings
CAMERA_INDEX=0
CAMERA_IDLE_TIMEOUT_SECONDS=60

# Face auto-login: recognize an enrolled face after it holds steady in
# front of the camera for this long, then log the person in with no card
# tap and no manual selection. Enroll faces with: python -m app.enroll_face <card_uid>
FACE_RECOGNITION_ENABLED=true
FACE_STABLE_SECONDS=3.0
FACE_CONFIDENCE_THRESHOLD=80.0
